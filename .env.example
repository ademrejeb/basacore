# ─────────────────────────────────────────────────────────────
# BASACORE — local development configuration
# Copy to .env and replace every value before any non-local use.
# Compose reads this file for interpolation; the backend also reads
# it when the API runs directly on the host.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (the runtime role is NOT the table owner, so RLS is enforced)
POSTGRES_DB=basa
POSTGRES_OWNER=platform_owner
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP=platform_app
POSTGRES_APP_PASSWORD=change-me-app

# Public URLs and local connection strings.
# Compose overrides the database/redis hosts with the service names.
APP_ENV=development
# INFO emits request logs; use WARNING only when volume is a concern.
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3002
INTERNAL_API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://platform_app:change-me-app@localhost:5434/basa
MIGRATION_DATABASE_URL=postgresql+asyncpg://platform_owner:change-me-owner@localhost:5434/basa
REDIS_URL=redis://localhost:6380/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Authentication
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=basacore
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MFA_CHALLENGE_TTL_MINUTES=5
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Development keys are generated under KEYS_DIR. Production must supply
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY as PEM, or mount a backed-up keys volume.
KEYS_DIR=./keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# 32-byte urlsafe base64 Fernet key. Generate:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Leave empty in development to auto-generate keys/encryption.key.
ENCRYPTION_KEY=

# Browser boundaries
CORS_ORIGINS=http://localhost:3002,http://localhost:3003
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003
MAX_REQUEST_BYTES=2097152

# Reverse proxies allowed to set X-Forwarded-For. Leave empty when the API is
# reached directly: the header is then ignored and the socket peer is recorded.
# Behind a load balancer, list only the proxy networks, e.g. 10.0.0.0/8.
TRUSTED_PROXY_CIDRS=
# Set to 1 only when Next.js itself sits behind a trusted proxy that sets the
# forwarded headers; otherwise the console proxy strips them.
TRUST_FORWARDED_HEADERS=0
# Show the seeded demo credentials on the login page. Set to 0 outside local use.
SHOW_DEMO_CREDENTIALS=1
# /docs, /redoc and /openapi.json are hidden in production unless this is true.
EXPOSE_API_DOCS=false

# End-user auth gateway (authorization-code + PKCE, OIDC, embedded login)
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=30
ID_TOKEN_TTL_MINUTES=15
AUTH_CODE_TTL_SECONDS=60

# External demo application on port 3003
DEMO_APP_BASE_URL=http://localhost:3003
DEMO_CLIENT_ID=basa_demo_atlas_web
DEMO_CLIENT_SECRET=bsc_demo_atlas_web_secret_2026
DEMO_TENANT=northwind-sales
DEMO_EMAIL=emma.wilson@northwind.dev

# Transactional email. Required in production: invitations and password resets
# depend on it. With no SMTP_HOST the API logs messages instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Seeding and startup
SEED_ADMIN_EMAIL=admin@basa.dev
SEED_ADMIN_PASSWORD=Adm1n!Basa#2026
# Container entrypoint: demo fixture on by default for local use.
SEED_DEMO=true
# Sync permissions/roles/policy when SEED_DEMO is false.
SEED_REFERENCE=true
# The entrypoint runs Alembic as the database owner before starting Uvicorn.
RUN_MIGRATIONS=true
